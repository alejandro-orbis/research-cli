# Copy this file to .env and fill in your keys. Never commit .env.

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# https://app.tavily.com
TAVILY_API_KEY=

# Optional: comma-separated models, tried in order (fallback when one is busy)
# GEMINI_MODEL=gemini-3.5-flash,gemini-3.7-flash,gemini-3.5-flash-lite

# Optional: domains to always skip, comma-separated (overridden by --exclude)
# EXCLUDE_DOMAINS=youtube.com,tiktok.com

# Optional: where to store the history database (default: research_history.db)
# RESEARCH_DB=research_history.db
